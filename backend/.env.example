NODE_ENV=development
PORT=5000
# Database mode: "local" (MongoDB Community Server on this PC) or "atlas" (cloud). Never switches automatically.
DB_MODE=local
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/lms_database
# Used only when DB_MODE=atlas. Keep this secret; it must never appear in frontend code.
ATLAS_URI=
# How long to wait for the database before failing startup (ms)
DB_TIMEOUT_MS=10000
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed web origins
CLIENT_ORIGIN=http://localhost:5173
# Used only by `npm run seed` (min 8 chars)
SEED_PASSWORD=
UPLOAD_DIR=
# Max size of one lesson file in MB (default 100). For large video, use object storage in production.
UPLOAD_MAX_MB=100
# Max size of one assignment submission in MB (default 10)
SUBMISSION_MAX_MB=10
# Real-time tuning in milliseconds (defaults shown)
PRESENCE_GRACE_MS=8000
ATTENDANCE_DISCONNECT_GRACE_MS=60000
DASHBOARD_DEBOUNCE_MS=1500
